# Production .env for cPanel shared hosting (shop.webspreed.com)
# Copy to the app folder on the server as `.env`, fill in the DB password, then run
# `php artisan key:generate` ONCE (see DEPLOYMENT.md). Never commit the real .env.

APP_NAME="Pick & Pearl"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="Asia/Dhaka"
APP_URL=https://shop.webspreed.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_CURRENCY=BDT
APP_CURRENCY_SYMBOL=৳

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel > MySQL Databases: database and user names get your cPanel username as prefix
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_shop
DB_USERNAME=cpaneluser_shop
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Shared hosting has no Redis: keep cache and queue in MySQL
CACHE_STORE=database
CACHE_PREFIX=pickpearl_
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=local

# No Node.js on the server: pages render in the browser
INERTIA_SSR_ENABLED=false

CSP_ENFORCE=false
CSP_REPORT_URI=
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
# Set to * only if the site is behind Cloudflare
TRUSTED_PROXIES=

RECAPTCHA_PROVIDER=recaptcha_v2
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Real SMTP is set in Admin > Email Settings; this is only the fallback
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@webspreed.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
